{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensynd.example/schema/mission-v1.json",
  "$comment": "SPDX-License-Identifier: GPL-2.0-or-later",
  "title": "OpenSynd mission",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "name", "license", "briefing", "map", "team", "opponents", "objectives"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "license": { "enum": ["CC0-1.0", "CC-BY-4.0"] },
    "briefing": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Headline shown when the operation succeeds." },
    "trainingBudget": { "type": "integer", "minimum": 2, "maximum": 10, "description": "Training points each operator may spend across their bars." },
    "story": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Opening text on the title screen." },
    "debrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "failure"],
      "properties": {
        "success": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "failure": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "map": { "$ref": "#/$defs/path" },
    "team": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/placement" } },
    "opponents": { "type": "array", "items": { "$ref": "#/$defs/placement" } },
    "objectives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/objective" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "path": { "type": "string", "pattern": "^[a-zA-Z0-9_./-]+\\.json$" },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unit", "position", "equipment"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "unit": { "$ref": "#/$defs/path" },
        "position": { "$ref": "#/$defs/position" },
        "equipment": { "$ref": "#/$defs/pathList" },
        "patrol": {
          "type": "array",
          "description": "Waypoints an opposition unit walks after its start, returning to the start and repeating.",
          "minItems": 1,
          "items": { "$ref": "#/$defs/position" }
        }
      }
    },
    "pathList": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" },
      "uniqueItems": true
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "targetZone", "required", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["reach-zone", "interact", "protect", "disable", "extract"] },
        "targetZone": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    }
  }
}
