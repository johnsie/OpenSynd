{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensynd.example/schema/equipment-v1.json",
  "$comment": "SPDX-License-Identifier: GPL-2.0-or-later",
  "title": "OpenSynd equipment",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "name", "description", "license", "type", "action", "charges", "effect"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 240 },
    "license": { "enum": ["CC0-1.0", "CC-BY-4.0"] },
    "type": { "enum": ["tool", "consumable"] },
    "action": { "enum": ["disable-pulse", "restore-vitality", "restore-energy", "stealth", "persuade", "time-bomb", "shield", "scan"] },
    "price": { "type": "integer", "minimum": 0, "maximum": 1000, "description": "Funds to buy one copy for an operative in the Armoury." },
    "icon": { "enum": ["pulse", "heavy-pulse", "medkit", "syringe", "cloak", "persuader", "smg", "rotary", "coil", "longshot", "bomb", "shield", "scatter", "flame", "beam", "scanner"], "description": "Which drawn icon represents the item." },
    "sound": { "enum": ["pistol", "smg", "rotary", "rifle", "coil", "longshot", "scatter", "flame", "beam"], "description": "What the weapon sounds like when it fires." },
    "carry": { "enum": ["pistol", "rifle"], "description": "How a weapon is held in the character art: one-handed pistol grip or two-handed rifle grip." },
    "weight": { "type": "integer", "minimum": 0, "maximum": 30, "description": "Carried weight; gear beyond an operative's capacity slows them." },
    "researchCost": { "type": "integer", "minimum": 0, "maximum": 500, "description": "Funds needed to research this item; 0 or absent means it is available from the start." },
    "charges": { "type": ["integer", "null"], "minimum": 1, "maximum": 99, "description": "Uses per operation: rounds for a weapon, doses for a consumable; null means unlimited." },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attack": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "range": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 },
        "cooldown": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
        "restoreVitality": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "restoreStamina": { "type": "number", "minimum": 0, "maximum": 1 },
        "restoreFocus": { "type": "number", "minimum": 0, "maximum": 1 },
        "sightFactor": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "pierce": { "type": "boolean", "description": "A shot passes through every enemy on its line." },
        "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 20, "description": "Time bomb: blast radius in tiles." },
        "fuse": { "type": "number", "exclusiveMinimum": 0, "maximum": 60, "description": "Time bomb: seconds from planting to blast." },
        "pellets": { "type": "integer", "minimum": 2, "maximum": 12, "description": "Scatter weapon: pulses per shot, fanned over `spread`. Each one that lands does `attack`." },
        "spread": { "type": "number", "minimum": 1, "maximum": 120, "description": "Scatter weapon: width of the fan in degrees." },
        "burn": {
          "type": "object", "additionalProperties": false, "required": ["dps", "seconds"],
          "description": "Sets the target alight: `dps` damage a second for `seconds` after the hit.",
          "properties": { "dps": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }, "seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 } }
        },
        "damageType": { "enum": ["bullet", "burn", "beam", "explosion"], "description": "What kind of harm it does; scenery responds to the kind." },
        "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 120, "description": "Shield: seconds it lasts." }
      },
      "minProperties": 1
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" }
  }
}
