{
  "formatVersion": 1,
  "id": "developer.quiet-hours",
  "name": "Quiet Hours",
  "license": "CC0-1.0",
  "title": "The audit trail is public",
  "briefing": "The district's audit yard hides three relays that were switched off to keep a maintenance scandal quiet. Restore all three, unlock the records compound at its control panel, and leave through it. Watchers cover every street, and a tired team is a slow team: spread the walking and rest between pushes.",
  "story": "Quiet Hours: a night shift the administrators never wanted recorded. Three relays in the Audit Yard were silenced so that no one could hear how the district's water and power contracts were being traded away. Your team has until dawn to bring them back, open the records compound, and walk out with the proof.",
  "debrief": {
    "success": "All three relays are live and the records compound stands open. By morning the whole district can read what was done in its name.",
    "failure": "The team is down and the audit yard stays silent. Rest your operators, spread out the walking, and try another route."
  },
