{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensynd.example/schema/map-v1.json",
  "$comment": "SPDX-License-Identifier: GPL-2.0-or-later",
  "title": "OpenSynd map",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "name", "license", "projection", "dimensions", "cellSize", "regions", "zones"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "license": { "enum": ["CC0-1.0", "CC-BY-4.0"] },
    "projection": { "const": "isometric-diamond" },
    "dimensions": { "$ref": "#/$defs/size" },
    "cellSize": { "$ref": "#/$defs/size" },
    "regions": {
      "type": "array",
      "minItems": 1,
      "description": "Rectangles are applied in order; later regions override earlier ones.",
      "items": { "$ref": "#/$defs/region" }
    },
    "zones": {
      "type": "array",
      "items": { "$ref": "#/$defs/zone" }
    },
    "props": {
      "type": "array",
      "description": "Street scenery that reacts to damage: trees and billboards burn, street lights and bins break. Props never block movement.",
      "items": { "$ref": "#/$defs/prop" }
    },
    "objects": {
      "type": "array",
      "description": "Interactive world objects. A gate blocks its tiles until the objective at its control zone is complete; a door lets anyone through but blocks sight and shots while closed.",
      "items": { "$ref": "#/$defs/object" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 512 },
        "height": { "type": "integer", "minimum": 1, "maximum": 512 }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height", "surface", "walkable", "elevation", "color"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "walkable": { "type": "boolean" },
        "elevation": { "type": "integer", "minimum": 0, "maximum": 15 },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "position", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["entry", "exit", "interaction", "hold", "deployment", "trigger"] },
        "prop": { "enum": ["relay", "console", "server", "beacon"], "description": "How an interaction or hold zone is drawn." },
        "position": { "$ref": "#/$defs/position" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "position", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["gate", "door"], "description": "A gate opens when its control objective is done; a door opens whenever a living person stands beside it." },
        "position": { "$ref": "#/$defs/position" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "control": { "$ref": "#/$defs/id" },
        "key": { "$ref": "#/$defs/id", "description": "Equipment id of a key that also opens the gate while its carrier stands next to it." }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["tree", "streetlight", "bin", "billboard", "wreck"] },
        "facing": { "enum": ["east-west", "north-south"], "description": "Which way a wreck lies." },
        "position": { "$ref": "#/$defs/position" }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  }
}
